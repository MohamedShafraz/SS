# Supabase Configuration
# Get these from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_POS_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_POS_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Must be at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_CURRENCY=lkr

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Offline Windows activation
# The POS needs this only for first activation, then it runs offline.
ACTIVATION_SERVER_URL=https://your-vercel-domain.vercel.app/api/activation/activate
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----"

# Vercel-hosted activation service.
# Keep these only in Vercel/project server env, never inside client installer files.
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----"
LICENSE_KEY_ID=offline-license-2026-01
ACTIVATION_ADMIN_TOKEN=replace-with-random-admin-token
KV_REST_API_URL=https://your-kv-rest-url
KV_REST_API_TOKEN=your-kv-rest-token
